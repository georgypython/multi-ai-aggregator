# ==========================================
# BACKEND (prefix: APP_CONFIG__)
# ==========================================
# API
APP_CONFIG__API__API_KEY="your-app-api-key"

# Database
APP_CONFIG__DB__HOST=localhost
APP_CONFIG__DB__PORT=5432
APP_CONFIG__DB__USER=postgres
APP_CONFIG__DB__PASSWD=postgres
APP_CONFIG__DB__NAME=postgres

# OpenRouter
APP_CONFIG__OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
APP_CONFIG__OPENROUTER__API_KEY="your-openrouter-api-key"

# WaveSpeed
APP_CONFIG__WAVESPEED__BASE_URL=https://api.wavespeed.ai
APP_CONFIG__WAVESPEED__API_KEY="your-wavespeed-api-key"
APP_CONFIG__WAVESPEED__POLL_INTERVAL_SECONDS=5
APP_CONFIG__WAVESPEED__POLL_MAX_ATTEMPTS=120

# Redis (backend)
APP_CONFIG__REDIS__HOST=localhost
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0
APP_CONFIG__REDIS__PASSWORD=
APP_CONFIG__REDIS__CHAT_HISTORY_TTL_SECONDS=604800
APP_CONFIG__REDIS__CHAT_HISTORY_LIMIT=15

# RabbitMQ
APP_CONFIG__RABBITMQ__HOST=localhost
APP_CONFIG__RABBITMQ__PORT=5672
APP_CONFIG__RABBITMQ__USER=guest
APP_CONFIG__RABBITMQ__PASSWORD=guest
APP_CONFIG__RABBITMQ__VHOST=/

# Storage (S3-compatible / MinIO)
APP_CONFIG__STORAGE__ENDPOINT_URL=https://your-s3-endpoint
APP_CONFIG__STORAGE__REGION=us-east-1
APP_CONFIG__STORAGE__ACCESS_KEY=minioadmin
APP_CONFIG__STORAGE__SECRET_KEY=minioadmin
APP_CONFIG__STORAGE__CONNECT_TIMEOUT_SECONDS=3.0
APP_CONFIG__STORAGE__READ_TIMEOUT_SECONDS=15.0
APP_CONFIG__STORAGE__MAX_RETRY_ATTEMPTS=2
APP_CONFIG__STORAGE__OPERATION_TIMEOUT_SECONDS=20.0
APP_CONFIG__STORAGE__BUCKET=ai-media
APP_CONFIG__STORAGE__PRESIGNED_TTL_SECONDS=900
APP_CONFIG__STORAGE__INPUT_RETENTION_HOURS=24
APP_CONFIG__STORAGE__INPUT_PREFIX=inputs
APP_CONFIG__STORAGE__MAX_UPLOAD_BYTES=10485760
# Optional complex overrides (JSON):
# APP_CONFIG__STORAGE__ALLOWED_IMAGE_CONTENT_TYPES=["image/jpeg","image/png","image/webp"]
# APP_CONFIG__STORAGE__IMAGE_EXTENSIONS={"image/jpeg":"jpg","image/png":"png","image/webp":"webp"}

# AI logic
APP_CONFIG__AI_LOGIC__NEW_USER_FREE_TOKENS=10


# ==========================================
# BOT (prefix: BOT__CONFIG__)
# ==========================================

# Telegram
BOT__CONFIG__TG__BOT_TOKEN="your-telegram-bot-token"

# AI backend connection
BOT__CONFIG__AI__AI_API_URL=http://localhost:8000
BOT__CONFIG__AI__API_KEY="your-app-api-key"
BOT__CONFIG__AI__REQUEST_TIMEOUT_SECONDS=120.0

# Redis (bot)
BOT__CONFIG__REDIS__HOST=localhost
BOT__CONFIG__REDIS__PORT=6379
BOT__CONFIG__REDIS__DB=0
BOT__CONFIG__REDIS__PASSWORD=
