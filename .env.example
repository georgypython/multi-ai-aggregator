# ==========================================
# Production-oriented minimal env example
# For docker-compose.prod.yml
# ==========================================

# ------------------------------
# Backend (*)
# ------------------------------

# API auth key used by bot and external API calls
API__API_KEY="change-me-app-api-key"
API__FRONTEND_ORIGIN="http://localhost:5173"

# HTTP bind for backend container
RUN__HOST=0.0.0.0
RUN__PORT=8000

# PostgreSQL (service: postgres)
DB__HOST=postgres
DB__PORT=5432
DB__USER=postgres
DB__PASSWD=change-me-postgres-password
DB__NAME=postgres

# Redis (service: redis)
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=change-me-redis-password

# OpenRouter
OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
OPENROUTER__API_KEY="change-me-openrouter-api-key"

# WaveSpeed
WAVESPEED__BASE_URL=https://api.wavespeed.ai
WAVESPEED__API_KEY="change-me-wavespeed-api-key"
WAVESPEED__WEBHOOK_SECRET="whsec_change_me"
# Public URL of backend webhook endpoint (for WaveSpeed callbacks)
WAVESPEED__WAVESPEED_WEBHOOK_URL="https://example.com/api/v1/webhooks/wavespeed"

# Telegram Bot API (used by backend worker for direct generation delivery)
TG__BOT_TOKEN="change-me-telegram-bot-token"

# Mini App cookie auth (users/me + auth/refresh)
AUTH__ACCESS_SECRET="change-me-access-secret"
AUTH__REFRESH_SECRET="change-me-refresh-secret"
AUTH__ALGORITHM=HS256
AUTH__ACCESS_TTL_MINUTES=60
AUTH__REFRESH_TTL_DAYS=7
AUTH__COOKIE_SECURE=false
AUTH__COOKIE_HTTPONLY=true
AUTH__COOKIE_SAMESITE=lax
# AUTH__COOKIE_DOMAIN=.example.com

# S3-compatible storage (service: minio)
STORAGE__ENDPOINT_URL=http://minio:9000
STORAGE__REGION=us-east-1
STORAGE__ACCESS_KEY=minioadmin
STORAGE__SECRET_KEY=change-me-minio-secret
STORAGE__BUCKET=ai-media

RABBITMQ__HOST=rabbitmq
RABBITMQ__PORT=5672
RABBITMQ__USER=guest
RABBITMQ__PASSWORD=change-me-postgres-password

# ------------------------------
# Bot (*)
# ------------------------------

TG__BOT_TOKEN="change-me-telegram-bot-token"
AI__AI_API_URL=http://backend:8000
AI__API_KEY="change-me-app-api-key"
APP__MINIAPP_URL="https://t.me/your_bot/your_miniapp"
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=change-me-redis-password


# frontend
VITE_API_BASE_URL=http://localhost:8000/api

