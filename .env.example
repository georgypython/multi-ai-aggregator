# ==========================================
# Production-oriented minimal env example
# For docker-compose.prod.yml
# ==========================================

# ------------------------------
# Backend (APP_CONFIG__*)
# ------------------------------

# API auth key used by bot and external API calls
APP_CONFIG__API__API_KEY="change-me-app-api-key"
APP_CONFIG__API__FRONTEND_ORIGIN="http://localhost:5173"

# HTTP bind for backend container
APP_CONFIG__RUN__HOST=0.0.0.0
APP_CONFIG__RUN__PORT=8000

# PostgreSQL (service: postgres)
APP_CONFIG__DB__HOST=postgres
APP_CONFIG__DB__PORT=5432
APP_CONFIG__DB__USER=postgres
APP_CONFIG__DB__PASSWD=change-me-postgres-password
APP_CONFIG__DB__NAME=postgres

# Redis (service: redis)
APP_CONFIG__REDIS__HOST=redis
APP_CONFIG__REDIS__PORT=6379
APP_CONFIG__REDIS__DB=0
APP_CONFIG__REDIS__PASSWORD=change-me-redis-password

# OpenRouter
APP_CONFIG__OPENROUTER__BASE_URL=https://openrouter.ai/api/v1
APP_CONFIG__OPENROUTER__API_KEY="change-me-openrouter-api-key"

# WaveSpeed
APP_CONFIG__WAVESPEED__BASE_URL=https://api.wavespeed.ai
APP_CONFIG__WAVESPEED__API_KEY="change-me-wavespeed-api-key"
APP_CONFIG__WAVESPEED__WEBHOOK_SECRET="whsec_change_me"
# Public URL of backend webhook endpoint (for WaveSpeed callbacks)
APP_CONFIG__WAVESPEED__WAVESPEED_WEBHOOK_URL="https://s3test.whoisjohngalt.xyz/api/v1/webhooks/wavespeed"

# Telegram Bot API (used by backend worker for direct generation delivery)
APP_CONFIG__TG__BOT_TOKEN="change-me-telegram-bot-token"

# Mini App cookie auth (users/me + auth/refresh)
APP_CONFIG__AUTH__ACCESS_SECRET="change-me-access-secret"
APP_CONFIG__AUTH__REFRESH_SECRET="change-me-refresh-secret"
APP_CONFIG__AUTH__ALGORITHM=HS256
APP_CONFIG__AUTH__ACCESS_TTL_MINUTES=60
APP_CONFIG__AUTH__REFRESH_TTL_DAYS=7
APP_CONFIG__AUTH__COOKIE_SECURE=false
APP_CONFIG__AUTH__COOKIE_HTTPONLY=true
APP_CONFIG__AUTH__COOKIE_SAMESITE=lax
# APP_CONFIG__AUTH__COOKIE_DOMAIN=.example.com

# S3-compatible storage (service: minio)
APP_CONFIG__STORAGE__ENDPOINT_URL=http://minio:9000
APP_CONFIG__STORAGE__REGION=us-east-1
APP_CONFIG__STORAGE__ACCESS_KEY=minioadmin
APP_CONFIG__STORAGE__SECRET_KEY=change-me-minio-secret
APP_CONFIG__STORAGE__BUCKET=ai-media

APP_CONFIG__RABBITMQ__HOST=postgres
APP_CONFIG__RABBITMQ__PORT=5432
APP_CONFIG__RABBITMQ__USER=postgres
APP_CONFIG__RABBITMQ__PASSWORD=change-me-postgres-password

# ------------------------------
# Bot (BOT__CONFIG__*)
# ------------------------------

BOT__CONFIG__TG__BOT_TOKEN="change-me-telegram-bot-token"
BOT__CONFIG__AI__AI_API_URL=http://backend:8000
BOT__CONFIG__AI__API_KEY="change-me-app-api-key"
BOT__CONFIG__APP__MINIAPP_URL="https://t.me/your_bot/your_miniapp"
BOT__CONFIG__REDIS__HOST=redis
BOT__CONFIG__REDIS__PORT=6379
BOT__CONFIG__REDIS__DB=0
BOT__CONFIG__REDIS__PASSWORD=change-me-redis-password


# frontend
VITE_API_BASE_URL=http://localhost:8000/api

